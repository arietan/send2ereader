# Vercel Blob token. Auto-injected when you link a Blob store on Vercel,
# or pull with `npx vercel env pull .env.local` after linking the project.
BLOB_READ_WRITE_TOKEN=

# Optional: shared secret the cron job (/api/cleanup) must present.
# If unset, /api/cleanup is callable without auth (fine for local dev).
CRON_SECRET=
